# Karen Configuration

# Groq API Configuration (Required for primary LLM and primary TTS)
GROQ_API_KEY=gsk_your_api_key_here
# Optional: fallback keys. Calls rotate round-robin across all configured keys
# and fail over to the next key on 401/403 (expired) or 429 (quota).
# GROQ_API_KEY_2=gsk_your_second_key_here
# GROQ_API_KEY_3=gsk_your_third_key_here
# Or a comma-separated list instead of numbered vars:
# GROQ_API_KEYS=gsk_key_one_here,gsk_key_two_here
# Optional: Override the LLM model used for reasoning
# GROQ_MODEL=llama3-8b-8192

# Groq TTS overrides
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_TTS_VOICE=karen

# Piper Local TTS Fallback (Required if Groq TTS hits rate limits or network fails)
# Path to the .onnx model file. The .onnx.json config must be in the same directory.
# Default: /usr/share/piper-voices/en/en_US/lessac/medium/en_US-lessac-medium.onnx
# or ~/.local/share/piper-voices/en/en_US/lessac/medium/en_US-lessac-medium.onnx
PIPER_MODEL_PATH=/home/shadowe/.local/share/piper-voices/en/en_US/lessac/medium/en_US-lessac-medium.onnx

# Whisper Local STT Configuration
# KAREN_WHISPER_MODEL=tiny.en

# Path to the Persona markdown file
KAREN_PERSONA_PATH=/home/shadowe/Projects/Karen/Persona.md

# Path to the devlogs root directory (for memory and tracking)
KAREN_DEVLOG_ROOT=/home/shadowe/Projects/SOFTWARE-ENGINEER
